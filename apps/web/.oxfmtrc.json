{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "endOfLine": "lf",
  "sortImports": {
    "groups": ["builtin", "external", ["internal", "parent"], "sibling"]
  },
  "sortPackageJson": true
}
