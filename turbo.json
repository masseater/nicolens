{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "GEMINI_API_KEY", "AUTH_SECRET", "AUTH_GITHUB_ID", "AUTH_GITHUB_SECRET"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "lint": {},
    "fmt": {},
    "fmt:check": {},
    "typecheck": {},
    "knip": {}
  }
}
